<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View for Travel Agency Trips -->
    <record id="view_travel_agency_trip_form" model="ir.ui.view">
        <field name="name">travel.agency.trip.form</field>
        <field name="model">travel.agency.trip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Trip Name / Title..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="partner_id"/>
                            <field name="pnr"/>
                            <field name="dk"/>
                            <field name="asesor"/>
                            <field name="destination_desc"/>
                        </group>
                        <group string="Dates &amp; Status">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state_appsheet"/>
                        </group>
                    </group>
                    <group string="External App Details">
                        <group>
                            <field name="appsheet_id" readonly="1"/>
                            <field name="solicitud_asociada"/>
                            <field name="link_costos" widget="url"/>
                        </group>
                        <group>
                            <field name="categoria"/>
                            <field name="especialidad"/>
                            <field name="num_pax"/>
                            <field name="balance_appsheet"/>
                        </group>
                    </group>
                    <group string="Passengers / Travelers">
                        <field name="travelers_desc" nolabel="1" placeholder="Passenger names..."/>
                    </group>
                    <notebook>
                        <page string="Financial Margin &amp; Invoices" name="finance">
                            <group>
                                <field name="total_income" readonly="1"/>
                                <field name="total_cost" readonly="1"/>
                                <field name="total_margin" readonly="1" decoration-bf="1" decoration-success="total_margin &gt; 0" decoration-danger="total_margin &lt; 0"/>
                            </group>
                            <field name="invoice_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="move_type"/>
                                    <field name="amount_untaxed"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_travel_agency_trip_tree" model="ir.ui.view">
        <field name="name">travel.agency.trip.list</field>
        <field name="model">travel.agency.trip</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pnr"/>
                <field name="partner_id"/>
                <field name="total_income" sum="Total Revenue"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="total_margin" sum="Total Margin"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_travel_agency_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">travel.agency.trip</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Navigation -->
    <menuitem id="menu_travel_agency_root" name="Travel Operations" sequence="10"/>
    <menuitem id="menu_travel_agency_trips" name="Trips" parent="menu_travel_agency_root" action="action_travel_agency_trip"/>
</odoo>
